# 必填：上游 API 根地址，使用 http:// 或 https://，不附加 /api 路径、查询参数或片段。
LB2A_UPSTREAM_BASE=

# 安装脚本默认生成随机密钥；手动配置时填写自定义密钥，留空关闭 API 鉴权。
LB2A_API_KEY=

# 必填：登录门户根地址，管理页 /admin 生成 OAuth 授权地址时使用。
# 留空不影响服务启动，但管理页只能查看账号，无法登录添加账号。
LB2A_LOGIN_PORTAL=

# 宿主机端口（1–65535）；容器内固定监听 8367。
LB2A_PORT=8367
# 宿主机监听 IPv4 地址；127.0.0.1 表示仅本机访问。
LB2A_BIND_ADDRESS=0.0.0.0
# IANA 时区，影响签到和保活调度。
TZ=Asia/Shanghai

# 上游请求超时，单位秒，正整数。
LB2A_TIMEOUT_SECONDS=180
# 冷却时间使用 Go duration 格式，例如 12h、60s、1h30m。
LB2A_HARD_CREDIT=12h
LB2A_SOFT_RATE=60s
LB2A_ERR_THRESHOLD=3
LB2A_ERR_COOLDOWN=10m

# 签到/保活整点小时，逗号分隔（0–23）；- 表示关闭对应任务。
LB2A_CHECKIN_HOURS=9,21
LB2A_KEEPALIVE_HOURS=22
# 账号额度刷新间隔；30m、2h、1h30m，0 或 - 表示关闭。
LB2A_CREDIT_REFRESH_INTERVAL=30m
# 客户端版本解析接口（签到用）；空值使用官方默认地址。
LB2A_UPDATE_URL=

# 项目名决定容器、网络和数据卷名称；首次安装后保持不变。
COMPOSE_PROJECT_NAME=lobsterai2api
# 本地构建镜像标签。
LB2A_IMAGE=lobsterai2api:local
